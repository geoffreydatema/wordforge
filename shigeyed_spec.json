    "ascii_to_symbol": {
        "!": "bang",
        "\"": "ellipsis_top",
        "#": "hash",
        "$": "krezhna",
        "%": "seal",
        "&": "subtle_down",
        "'": "quote",
        "(": "parentheses_open",
        ")": "parentheses_close",
        "*": "asterisk",
        "+": "plus",
        ",": "sequence_down",
        "-": "minus",
        ".": "period",
        "/": "slash",
        ":": "colon",
        ";": "terminator",
        "<": "chevron_open",
        "=": "equals",
        ">": "chevron_close",
        "?": "reverse_bang",
        "@": "placeholder",
        "[": "bracket_open",
        "\\": "backslash",
        "]": "bracket_close",
        "^": "insert_top",
        "_": "border_bottom",
        "`": "sequence_up",
        "{": "entry",
        "|": "pipe",
        "}": "exit",
        "~": "subtle",
        "*=": "angle_bottom_left",
        "/=": "angle_bottom_right",
        "+=": "angle_top_left",
        "-=": "angle_top_right",
        ":.": "border_bottom_left",
        "!||": "border_bottom_right",
        "/%": "border_left",
        "/%=": "border_right",
        "**=": "border_top",
        "<=": "border_top_left",
        ">=": "border_top_right",
        "...": "ellipsis_bottom",
        "??": "hexagon_border",
        "@@": "hexagon_filled",
        "!>>": "insert_bottom",
        "<<": "insert_left",
        ">>": "insert_right",
        "||": "queue",
        "!=": "rectangle_border",
        "&&": "rectangle_filled",
        "**": "unity",
        "::": "set",
        ":@": "series",
        ":?": "shade",
        "!!": "operator",
        "==": "stack",
        ":#": "sigma",
        "->": "subtle_up",
        "--": "triangle_down",
        ":<<": "triangle_left",
        ":>>": "triangle_right",
        "++": "triangle_up"
    }
